  "scripts": {
    "start": "node ./node_modules/expo/bin/cli start --dev-client",
    "start:clear": "node ./node_modules/expo/bin/cli start --dev-client --clear",
    "android": "node ./node_modules/expo/bin/cli start --dev-client --android",
    "ios": "node ./node_modules/expo/bin/cli start --dev-client --ios",
    "web": "node ./node_modules/expo/bin/cli start --web",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "eas": "node ./node_modules/eas-cli/bin/run",
    "reset-project": "node ./scripts/reset-project.js",
    "eas-build-pre-install": "rm -f package-lock.json && npm install --package-lock-only --include=dev"
